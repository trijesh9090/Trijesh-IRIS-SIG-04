# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=iris
POSTGRES_PASSWORD=change-me
POSTGRES_DB=iris
POSTGRES_PORT=5433
DATABASE_URL=postgresql://iris:change-me@localhost:5433/iris

